@startuml
title US-LOAN-03 — Retour (Bibliothécaire) — modèle avec mise de côté

actor Bibliothécaire as B
participant "LoanController" as C
participant "LoanService" as S
participant "ILoanDao" as LD
participant "IBookCopyDao" as BCD
box "SQL Server — base bookhub" #F5F5F5
database "table\nloan" as TLOAN
database "déclencheur\nsur loan" as T
database "procédure\nsp_promouvoir_file" as P
database "table\nreservation" as TRES
database "table\nbook_copy" as TBC
end box
participant "GlobalExceptionHandler" as E

B -> C : POST /api/loans/{id}/retour
activate C
note right of C : action réservée à LIBRARIAN et ADMIN\n(rôles cumulatifs)
C -> S : enregistrerRetour(loanId)
activate S

group @Transactional

    S -> LD : findById(loanId)
    LD --> S : emprunt ou vide

    alt l'emprunt n'existe pas
        S -> E : lève ResourceNotFoundException
        E --> B : 404 emprunt introuvable

    else l'emprunt existe

        alt l'emprunt est déjà au statut RETURNED
            note right of S : cas d'un double enregistrement\ndu même retour par le bibliothécaire
            S -> E : lève ConflictException
            E --> B : 409 retour déjà enregistré

        else l'emprunt est actif

            S -> LD : save(returnDate = aujourd'hui,\nstatut = RETURNED)
            note right of LD : deux statuts seulement : ACTIVE et RETURNED.\nLe retard éventuel se déduit de due_date,\nil n'est pas un statut (RG-LOAN-03).

            LD -> TLOAN : UPDATE loan
            TLOAN -> T : le déclencheur se déclenche
            activate T
            note right of T : le déclencheur part sur l'UPDATE de loan.\nIl s'exécute dans la base, ne reçoit\naucun appel de l'application et ne\nlui renvoie rien (US-RESA-03).

            T -> P : appelle sp_promouvoir_file\n(book_id, book_copy_id rendu)
            activate P
            note right of P : logique écrite une seule fois.\nTrois chemins l'appellent :\nce déclencheur, la tâche d'expiration,\net l'annulation d'une réservation AVAILABLE.

            P -> TRES : SELECT la PENDING la plus ancienne\nde ce livre (ordre par reserves_date)

            alt aucune réservation en attente
                P -> TRES : aucune écriture
                note right of P : l'exemplaire redevient simplement\nempruntable par tous

            else une file existe
                P -> TRES : UPDATE le PREMIER :\nstatut = AVAILABLE,\nbook_copy_id = l'exemplaire rendu,\nnotified_at = SYSUTCDATETIME(),\npickup_deadline = notified_at + 72h
                P -> TBC : l'exemplaire est marqué\nmis de côté
                note right of P : seul le premier de la file est notifié.\nL'exemplaire lui est mis de côté :\naucun autre lecteur ne peut l'emprunter\npendant 72h. Les suivants restent PENDING\net avancent d'un rang.\n--\n72h fixes, et non 24h : la bibliothèque a des\njours de fermeture. Reporter la date sur le\nprochain jour ouvré exigerait un référentiel\nd'horaires, absent du périmètre.\n--\nHeure UTC des deux côtés : Java écrit\nreserves_date en UTC, la base fait de même.\n--\nNotification = statut visible dans l'espace\npersonnel. Aucun courriel n'est envoyé.
            end

            deactivate P
            T --> TLOAN : déclencheur terminé
            deactivate T
            TLOAN --> LD : UPDATE loan terminé\n(déclencheur inclus)
            LD --> S : emprunt mis à jour

            S -> BCD : relire l'exemplaire
            BCD --> S : book_status et réservation éventuelle
            note right of S : le service et le déclencheur ne se parlent pas\ndirectement : ils communiquent par la BD.\nLe déclencheur écrit dans la BD, puis le service\nlit pour voir ce qu'il a fait.

            S --> C : LoanResponse
            C --> B : 200 OK
        end
    end

end

deactivate S
deactivate C

@enduml
