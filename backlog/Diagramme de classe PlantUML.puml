@startuml BookHub-ClassDiagramskinparam classAttributeIconSize 0enum Role {  ROLE_USER  ROLE_ADMIN  ROLE_LIBRARIAN}enum BookStatus {  AVAILABLE  LOANED  LOST  IN_REPAIR  RESERVED}enum Condition {  NEW  GOOD  WORN  DAMAGED}enum LoanStatus {  ACTIVE  RETURNED  OVERDUE}enum ReservationStatus {  PENDING  READY_FOR_PICKUP  FULFILLED  CANCELLED  EXPIRED}enum ReviewStatus {  ACTIVE  MODERATED}class User implements UserDetails {  -Long id  -String firstname  -String lastname  -String phone <<unique>>  -String username <<unique>>  -String email <<unique>>  -String password  -Role role  +getDisplayUsername(): String}class Author {  -Long id  -String firstname  -String lastname  -String penName  .. check constraint ..  penName NOT NULL OR (lastname AND firstname NOT NULL)}class Genre {  -Long id  -String label}class Book {  -Long id  -String title  -String isbn  -String img  -LocalDate publishDate  -String description}class BookCopy {  -Long id  -String serialNumber  -BookStatus bookStatus  -Condition condition}class Loan {  -Long id  -LocalDate loanDate  -LocalDate dueDate  -LocalDate returnDate  -LoanStatus status}class Reservation {  -Long id  -LocalDateTime reservesDate  -ReservationStatus status  -LocalDateTime notifiedAt  -LocalDateTime pickupDeadline  +Reservation(User, Book)}class Review {  -Long id  -int rating  -String comment  -ReviewStatus status  -LocalDateTime createdAt  -LocalDateTime updatedAt  -LocalDateTime moderatedAt  .. unique constraint ..  (users_id, book_id)}class RefreshToken {  -Long id  -String tokenHash <<unique>>  -Instant expiresAt  -boolean revoked  +isExpired(): boolean}' --- Relations Book ---Book "*" -- "*" Genre : book_genre >Book "*" -- "*" Author : book_author >Book "1" *-- "*" BookCopy : copies\n(cascade ALL, orphanRemoval)' --- Relations BookCopy ---BookCopy "*" --> "1" Book : book_id' --- Relations Loan ---Loan "*" --> "1" User : loanerLoan "*" --> "1" BookCopy : bookCopyLoaned' --- Relations Reservation ---Reservation "*" --> "1" User : user (users_id)Reservation "*" --> "1" Book : book (book_id)Reservation "*" --> "0..1" BookCopy : bookCopy (book_copy_id)' --- Relations Review ---Review "*" --> "1" User : user (users_id)Review "*" --> "1" Book : book (book_id)' --- Relations RefreshToken ---RefreshToken "*" --> "1" User : user (user_id)User -- RoleBookCopy -- BookStatusBookCopy -- ConditionLoan -- LoanStatusReservation -- ReservationStatusReview -- ReviewStatus@enduml